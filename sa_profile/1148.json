{
    "process": "nfc_tag_service",
    "systemability": [
        {
            "name": 1148,
            "libpath": "libnfc_tag_service.z.so",
            "run-on-create": false,
            "distributed": false,
            "dump_level": 1,
            "min_hdi_proxy_version": [
                "libconnected_nfc_tag_proxy_1.1.z.so"
            ],
            "start-on-demand": {
                "commonevent": [
                    {
                        "name": "usual.event.BOOT_COMPLETED",
                        "conditions": [
                            {
                                "eventId": "param",
                                "name": "const.nfc.support_connected_tag",
                                "value": "true"
                            }
                        ]
                    }
                ]
            }
        }
    ]
}