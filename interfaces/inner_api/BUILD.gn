import("//build/ohos.gni")
import("//build/ohos_var.gni")
import("//foundation/communication/connected_nfc_tag/connected_nfc_tag.gni")

config("nfc_tag_config") {
  include_dirs = [
    "$NFC_TAG_DIR/interfaces/inner_api/include",
  ]
}

config("nfc_tag_public_config") {
  include_dirs = ["include"]
}

ohos_shared_library("nfc_tag_inner_kits") {
  cflags = common_cflags
  cflags_cc = common_cflags
  sanitize = global_sanitize
  defines = global_defines
  branch_protector_ret = "pac_ret"
  configs = [ ":nfc_tag_config" ]
  public_configs = [ ":nfc_tag_public_config" ]
  sources = [
    "src/nfc_tag_callback_stub.cpp",
    "src/nfc_tag_client.cpp",
    "src/nfc_tag_proxy.cpp",
  ]

  deps = []

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "communication"
  part_name = "connected_nfc_tag"
}

ohos_static_library("nfc_tag_inner_kits_test") {
  defines = global_defines
  cflags_cc = [ "--coverage" ]
  cflags = [ "--coverage" ]
  ldflags = [ "--coverage" ]
  configs = [ ":nfc_tag_config" ]
  public_configs = [ ":nfc_tag_public_config" ]
  sources = [
    "src/nfc_tag_callback_stub.cpp",
    "src/nfc_tag_client.cpp",
    "src/nfc_tag_proxy.cpp",
  ]

  deps = []

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "communication"
  part_name = "connected_nfc_tag"
}

ohos_static_library("nfc_tag_inner_kits_fuzz") {
  defines = global_defines
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  configs = [":nfc_tag_config]
  public_configs = [":nfc_tag_public_config"]
  sources = [
    "src/nfc_tag_callback_stub.cpp",
    "src/nfc_tag_client.cpp",
    "src/nfc_tag_proxy.cpp",
  ]

  deps = []

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core"，
    "samgr:samgr_proxy",
  ]

  subsystem_name = "communication"
  part_name = "connected_nfc_tag"
}